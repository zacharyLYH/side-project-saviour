# Multi-stage build: compile on golang, run on plain alpine.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/sps ./cmd/server

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=build /out/sps /usr/local/bin/sps
EXPOSE 8080
ENTRYPOINT ["sps"]
